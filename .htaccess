# ==============================================================================
# .htaccess — Gracie Barra São Mateus (Guriri, ES)
# Configuração otimizada para HostGator (Apache Shared Hosting)
# ==============================================================================

# 1. Proteção contra listagem de diretórios
Options -Indexes

# 2. Codificação padrão UTF-8
AddDefaultCharset UTF-8

# 3. Forçar HTTPS (SSL/TLS)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 4. Tratamento de página de erro 404
ErrorDocument 404 /404.html

# 5. Compressão Gzip via mod_deflate
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE text/plain
</IfModule>

# 6. Políticas de Cache via mod_expires
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML: Sem cache longo para permitir atualizações ágeis
  ExpiresByType text/html "access plus 0 seconds"

  # CSS e JavaScript: 1 mês
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"

  # Imagens: 1 ano
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fontes: 1 ano
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"

  # Dados estruturados e XML: 1 hora
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
</IfModule>

# 7. Cabeçalhos de Segurança Básicos
<IfModule mod_headers.c>
  # Previne sniffing de MIME-type
  Header always set X-Content-Type-Options "nosniff"

  # Previne clickjacking mantendo em SAMEORIGIN
  Header always set X-Frame-Options "SAMEORIGIN"

  # Controle de referrer para privacidade e segurança
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Ativa proteção XSS nos navegadores legados
  Header always set X-XSS-Protection "1; mode=block"

  # Permissions policy básica
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# 8. Proteção de arquivos ocultos e de configuração (.git, .docs, .htaccess, etc.)
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
